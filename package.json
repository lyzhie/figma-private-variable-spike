    "verify": "npm run check && npm run build && node tests/mock-plugin.cjs",
    "configure": "node scripts/configure.cjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
