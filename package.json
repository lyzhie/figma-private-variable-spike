{
  "name": "figma-private-variable-spike",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=browser --target=es2020 --format=iife --outfile=dist/code.js && cp src/ui.html dist/ui.html",
